tbody.addEventListener("dblclick", function(evnts) {
    var cell = evnts.target.closest("td");
    if (!cell) return;
    var existingInput = tbody.querySelector(".cell-input");
    if (existingInput) {
        var valueToSave = existingInput.value.trim();
        var parentCell = existingInput.parentElement;
        parentCell.textContent = valueToSave === "" ? existingInput.defaultValue : valueToSave;
    }
    if (!cell.querySelector("input")) {
        var originalText = cell.textContent;
        var cellInput = document.createElement("input");
        cellInput.classList.add("cell-input");
        cellInput.value = originalText;
        cellInput.defaultValue = originalText;
        cell.textContent = "";
        cell.append(cellInput);
        cellInput.focus();
        cellInput.addEventListener("blur", function() {
            var val = cellInput.value.trim();
            cellInput.parentElement.textContent = val === "" ? cellInput.defaultValue : val;
        });
        cellInput.addEventListener("keydown", function(evnt) {
            if (evnt.key === "Enter") {
                evnt.preventDefault();
                var val = cellInput.value.trim();
                cellInput.parentElement.textContent = val === "" ? cellInput.defaultValue : val;
            }
        });
    }
});

